rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isApprovedUser() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved != false;
    }

    function isValidLoginMethod(value) {
      return value in ['email', 'google', 'hubid'];
    }

    // Users collection
    match /users/{userId} {
      // Owners can always read their own doc; approved users/admins can read the directory.
      allow read: if isOwner(userId) || isApprovedUser() || isAdmin();

      // Users can create their own document during registration
      allow create: if isOwner(userId) &&
        request.resource.data.approved == false &&
        request.resource.data.role == 'member';

      // Approved users can update their own profile fields (but not role/approval)
      allow update: if isOwner(userId) && isApprovedUser() &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'loginMethod', 'approved']) ||
          (
            resource.data.loginMethod == null &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loginMethod']) &&
            isValidLoginMethod(request.resource.data.loginMethod)
          )
        );

      // Allow one-time loginMethod backfill even before approval.
      allow update: if isOwner(userId) &&
        resource.data.loginMethod == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['loginMethod']) &&
        isValidLoginMethod(request.resource.data.loginMethod);

      // Admins can update any user (including role/approval)
      allow update: if isAdmin();

      // No one can delete users
      allow delete: if false;
    }

    // Shifts collection
    match /shifts/{shiftId} {
      // Approved users can read shifts
      allow read: if isApprovedUser();

      // Only admins can create/delete shifts
      allow create, delete: if isAdmin();

      // Admins can update anything, members can only update slots (for sign-up)
      allow update: if isAdmin() || (isApprovedUser() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots']));
    }

    // Camp Maps collection
    match /campMaps/{year} {
      // Approved users can read maps
      allow read: if isApprovedUser();

      // Only admins can create/update/delete maps
      allow create, update, delete: if isAdmin();
    }

    // Media collection
    match /media/{mediaId} {
      // Approved users and admins can read all media
      allow read: if isApprovedUser() || isAdmin();

      // Approved users and admins can create media
      allow create: if (isApprovedUser() || isAdmin()) &&
        request.resource.data.uploadedBy == request.auth.uid;

      // Users can delete their own media, admins can delete any
      allow delete: if isAdmin() ||
        (isApprovedUser() && resource.data.uploadedBy == request.auth.uid);

      // No updates to media (immutable once created)
      allow update: if false;
    }

    // Contacts collection (contact forms, whatsapp requests, issue reports)
    match /contacts/{contactId} {
      // Anyone can create contact submissions (even unauthenticated)
      allow create: if true;

      // Only admins can read, update, delete
      allow read, update, delete: if isAdmin();
    }

    // Site config
    match /config/{configId} {
      // Anyone can read config (for public pages)
      allow read: if true;

      // Only admins can update config
      allow write: if isAdmin();
    }

  }
}
