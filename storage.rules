rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin is determined by a custom auth claim (set server-side for users
    // with role 'admin'). This avoids an unreliable cross-service Firestore
    // read from Storage rules. Requires a token refresh / re-login to take effect.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    match /media/{year}/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    match /avatars/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /campMaps/{year}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
